# Copy to .env and fill in.

# earthengine = real NASA data (needs credentials below); mock = fake numbers for frontend work.
BEKEM_PROVIDER=earthengine

# Your Google Cloud project registered for Earth Engine.
BEKEM_EE_PROJECT=

# Server deployments: path to a service-account JSON key, or paste the JSON itself.
# Local dev: leave both empty and run `earthengine authenticate` once.
BEKEM_EE_SERVICE_ACCOUNT_KEY=
BEKEM_EE_SERVICE_ACCOUNT_KEY_JSON=

# NASA Earthdata login (free: https://urs.earthdata.nasa.gov/users/new). Used for AppEEARS and Giovanni.
# Never commit .env: it is in .gitignore.
BEKEM_EARTHDATA_USERNAME=
BEKEM_EARTHDATA_PASSWORD=

# Optional: Earth Engine asset id of the NASA Global Landslide Susceptibility GeoTIFF.
BEKEM_LANDSLIDE_ASSET=

# JSON list of allowed frontend origins.
BEKEM_CORS_ORIGINS=["*"]
BEKEM_RATE_LIMIT_PER_MIN=30
