{
  "hosting": {
    "public": "deploy/firebase/public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/**", "run": { "serviceId": "bekem-api", "region": "europe-west1" } },
      { "source": "/docs", "run": { "serviceId": "bekem-api", "region": "europe-west1" } },
      { "source": "/openapi.json", "run": { "serviceId": "bekem-api", "region": "europe-west1" } },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
