{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bekem",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // Frontend. Point "directory" at the frontend's build output (e.g. "../../frontend/dist") once it exists.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/docs", "/openapi.json"]
  },

  // Backend: our existing Docker image, built from backend/ by wrangler.
  "containers": [
    {
      "class_name": "BekemApi",
      "image": "../../backend/Dockerfile",
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "BEKEM_API", "class_name": "BekemApi" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BekemApi"] }],

  // Not secret. Secrets (service-account key, Earthdata login) go in the Cloudflare dashboard.
  "vars": {
    "BEKEM_PROVIDER": "earthengine",
    "BEKEM_EE_PROJECT": "bekem-514710",
    "BEKEM_CORS_ORIGINS": "[\"*\"]"
  }
}
